{
  "name": "intact-web",
  "description": "Intact school community web application and API",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "prisma:validate": "prisma validate",
    "test": "tsx --test tests/*.test.ts",
    "test:moderation": "tsx --test tests/moderation.test.ts",
    "test:riro": "tsx --test tests/riro.test.ts",
    "smoke:resource-upload": "tsx scripts/resource-upload-smoke.ts",
    "platform-aliases:backfill": "tsx scripts/platform-alias-backfill.ts",
    "verify": "bash ../scripts/verify.sh",
    "push": "prisma db push",
    "postpush": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.2.0",
    "lucide-react": "^0.269.0",
    "next": "15.5.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "redis": "6.1.0",
    "sharp": "^0.34.5",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.20.6",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/web-push": "3.6.4",
    "autoprefixer": "^10.5.4",
    "brace-expansion": "^5.0.7",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.18",
    "postcss": "^8.5.19",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  },
  "resolutions": {
    "ajv": "^6.15.0",
    "braces": "^3.0.3",
    "cross-spawn": "^7.0.6",
    "eslint/**/minimatch": "^3.1.5",
    "flatted": "^3.4.2",
    "js-yaml": "^4.2.0",
    "micromatch": "^4.0.8",
    "nanoid": "^3.3.11",
    "**/anymatch/picomatch": "^2.3.2",
    "**/micromatch/picomatch": "^2.3.2",
    "**/readdirp/picomatch": "^2.3.2",
    "postcss": "^8.5.19",
    "socket.io-parser": "^4.2.6",
    "ws": "^8.21.0"
  }
}
